{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gagan046-dev/pipelinedoctor/blob/main/schemas/eval-result.v1.schema.json",
  "$defs": {
    "Category": {
      "enum": [
        "dependency",
        "test",
        "lint",
        "build",
        "docker",
        "config",
        "secret_permission",
        "flaky",
        "infrastructure",
        "unknown"
      ],
      "title": "Category",
      "type": "string"
    },
    "EvalAggregate": {
      "additionalProperties": false,
      "properties": {
        "cases_total": {
          "title": "Cases Total",
          "type": "integer"
        },
        "cases_scored": {
          "title": "Cases Scored",
          "type": "integer"
        },
        "cases_skipped": {
          "title": "Cases Skipped",
          "type": "integer"
        },
        "category_accuracy": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category Accuracy"
        },
        "evidence_validity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Validity"
        },
        "key_fact_recall": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key Fact Recall"
        },
        "secret_leak_free": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Secret Leak Free"
        },
        "judge_score_mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Judge Score Mean"
        },
        "llm_coverage": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Llm Coverage"
        },
        "latency_p50_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency P50 Ms"
        },
        "latency_p95_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency P95 Ms"
        },
        "total_cost_usd": {
          "default": 0.0,
          "title": "Total Cost Usd",
          "type": "number"
        },
        "total_llm_calls": {
          "default": 0,
          "title": "Total Llm Calls",
          "type": "integer"
        },
        "cache_hits": {
          "default": 0,
          "title": "Cache Hits",
          "type": "integer"
        }
      },
      "required": [
        "cases_total",
        "cases_scored",
        "cases_skipped"
      ],
      "title": "EvalAggregate",
      "type": "object"
    },
    "EvalCaseResult": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "scored",
            "skipped_budget",
            "skipped_no_key",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "cache_hit": {
          "default": false,
          "title": "Cache Hit",
          "type": "boolean"
        },
        "expected_category": {
          "$ref": "#/$defs/Category"
        },
        "predicted_category": {
          "anyOf": [
            {
              "$ref": "#/$defs/Category"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "category_correct": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category Correct"
        },
        "evidence_cited": {
          "default": 0,
          "title": "Evidence Cited",
          "type": "integer"
        },
        "evidence_valid": {
          "default": 0,
          "title": "Evidence Valid",
          "type": "integer"
        },
        "evidence_validity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Validity"
        },
        "key_facts_total": {
          "default": 0,
          "title": "Key Facts Total",
          "type": "integer"
        },
        "key_facts_matched": {
          "default": 0,
          "title": "Key Facts Matched",
          "type": "integer"
        },
        "key_fact_recall": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key Fact Recall"
        },
        "no_secret_leak": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "No Secret Leak"
        },
        "judge_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Judge Score"
        },
        "source": {
          "anyOf": [
            {
              "enum": [
                "llm",
                "rules_fallback",
                "rules_only"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "model_used": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Used"
        },
        "llm_calls": {
          "default": 0,
          "title": "Llm Calls",
          "type": "integer"
        },
        "latency_ms": {
          "default": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "cost_usd": {
          "default": 0.0,
          "title": "Cost Usd",
          "type": "number"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "case_id",
        "status",
        "expected_category"
      ],
      "title": "EvalCaseResult",
      "type": "object"
    },
    "EvalRunInfo": {
      "additionalProperties": false,
      "properties": {
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "finished_at": {
          "title": "Finished At",
          "type": "string"
        },
        "mode": {
          "enum": [
            "pr",
            "nightly"
          ],
          "title": "Mode",
          "type": "string"
        },
        "subset": {
          "enum": [
            "pr",
            "all"
          ],
          "title": "Subset",
          "type": "string"
        },
        "git_sha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Sha"
        },
        "prompt_version": {
          "title": "Prompt Version",
          "type": "string"
        },
        "prompt_sha256": {
          "title": "Prompt Sha256",
          "type": "string"
        },
        "models": {
          "items": {
            "type": "string"
          },
          "title": "Models",
          "type": "array"
        },
        "engine_fingerprint": {
          "title": "Engine Fingerprint",
          "type": "string"
        },
        "engine_version": {
          "title": "Engine Version",
          "type": "string"
        },
        "llm_mode": {
          "enum": [
            "live",
            "cache-only",
            "rules"
          ],
          "title": "Llm Mode",
          "type": "string"
        },
        "judge": {
          "default": false,
          "title": "Judge",
          "type": "boolean"
        }
      },
      "required": [
        "started_at",
        "finished_at",
        "mode",
        "subset",
        "prompt_version",
        "prompt_sha256",
        "models",
        "engine_fingerprint",
        "engine_version",
        "llm_mode"
      ],
      "title": "EvalRunInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "run": {
      "$ref": "#/$defs/EvalRunInfo"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/EvalCaseResult"
      },
      "title": "Cases",
      "type": "array"
    },
    "aggregate": {
      "$ref": "#/$defs/EvalAggregate"
    },
    "skipped_reason": {
      "anyOf": [
        {
          "enum": [
            "no_api_key",
            "budget"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Skipped Reason"
    }
  },
  "required": [
    "run",
    "cases",
    "aggregate"
  ],
  "title": "EvalResult",
  "type": "object"
}
