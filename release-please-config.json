{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "pipelinedoctor",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "include-v-in-tag": true,
      "extra-files": [
        { "type": "toml", "path": "pyproject.toml", "jsonpath": "$.project.version" },
        { "type": "toml", "path": "console/pyproject.toml", "jsonpath": "$.project.version" },
        { "type": "generic", "path": "src/pipelinedoctor/__init__.py" },
        { "type": "generic", "path": "console/src/pipelinedoctor_console/__init__.py" },
        { "type": "generic", "path": "action.yml" },
        { "type": "toml", "path": "uv.lock", "jsonpath": "$.package[?(@.name.value=='pipelinedoctor')].version" },
        { "type": "toml", "path": "console/uv.lock", "jsonpath": "$.package[?(@.name.value=='pipelinedoctor-console')].version" }
      ]
    }
  }
}
